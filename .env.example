# b2base-platform — variáveis de ambiente (exemplo, sem segredos reais)
# Copie para .env e preencha. NUNCA commite o .env real (constituição V).

# ── Banco (Prisma) ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/b2base"

# ── Gateway LLM (LiteLLM, API OpenAI-compatível) ────────────────────────────
# Usado por llm-client.js (campanhas, extração Ava, análise profunda 005).
LITELLM_URL="http://localhost:4000"
LITELLM_MODEL="qwen/qwen2.5-7b-instruct"
# LITELLM_API_KEY="..."
# Modelo COM VISÃO para ler material de imagem no Studio (studio/ai/vision.js)
# — SEM ele a visão cai no LITELLM_MODEL, e modelo só-texto deixa toda imagem
# em needs_manual. Precisa estar roteado no gateway. (2026-10-16)
# STUDIO_VISION_MODEL="gpt-4o-mini"
# Modelo de GERAÇÃO de imagem (banner por IA no chat, studio/ai/image-gen.js)
# — sem ele o card diz honestamente que o motor não está configurado.
# STUDIO_IMAGE_MODEL=""

# ── Análise profunda de lead (feature 005, premium) ─────────────────────────
# Modelo/alias específico da análise; cai no LITELLM_MODEL se ausente/falhar.
# DEEP_ANALYSIS_LLM_MODEL=""
# Reconciliação no boot: re-despacha análises presas em 'running' (padrão
# resumePendingEnrichments). Desabilite com "false"; limite por varredura.
# DEEP_ANALYSIS_RECONCILE_ON_BOOT="true"
# DEEP_ANALYSIS_RECONCILE_LIMIT="100"

# ── Discovery Engine (specs/006-discovery-engine) ───────────────────────────
# Providers self-hosted/free (sem chave, sempre ativos): searxng, crtsh,
# dns-rdap, http-metadata. CNPJ MCP usa as vars abaixo (já existentes).
# CNPJ_MCP_URL="https://mcps.0xcloud.net/mcp"
# CNPJ_MCP_TOKEN=""
# SEARXNG_URL="https://search.0xcloud.net"
# Enumeração passiva de subdomínios (Chaos/ProjectDiscovery — opcional)
# PROJECTDISCOVERY_API_KEY=""
# Providers pagos — budget-gated; ausentes → run "skipped" com fallback (T040)
# SERPER_API_KEY=""
# BRAVE_API_KEY=""
# EXA_API_KEY=""
# Jurídicos (opcionais, budget-gated)
# JUSBRASIL_TOKEN=""
# ESCAVADOR_TOKEN=""
# Financeiros (opcionais; mirror CVM + agregador de funding)
# CVM_BASE_URL=""
# FUNDING_BASE_URL=""
# FUNDING_API_KEY=""
# SpiderFoot: APENAS adapter de compatibilidade, fora do caminho crítico
# SPIDERFOOT_URL=""
# SPIDERFOOT_API_KEY=""
# SPIDERFOOT_TIMEOUT_MS="60000"

# ── Gate Twilio Lookup (WhatsApp do site — workers/digital-presence.js) ─────
# Valida o wa.me extraído do site ANTES de virar telefone prioritário do lead
# (Line Type Intelligence: fixo/0800/voicemail/inválido são rejeitados e o
# lead mantém o fixo da Receita). Pacote é COBRADO por lookup (~US$ 0,005);
# rate limit via enrichment-provider-registry (provider 'twilio.lookup').
# Sem credenciais o gate é fail-open (promove como antes da integração).
# Recomendado: API Key do console (console.twilio.com → API keys & tokens)
# TWILIO_API_KEY_SID=""
# TWILIO_API_KEY_SECRET=""
# Alternativa: Account SID + Auth Token
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""

# ─── Campaign Studio (specs/010) ────────────────────────────────────
# Volume local dos materiais carregados (PDF/DOCX/PPTX/imagem/vídeo).
# Default: ./.data/studio. Em produção, montar como volume persistente.
# STUDIO_STORAGE_DIR="./.data/studio"

# ─── Captura de leads (Epic 2, studio/capture-service.js) ───────────
# Mínimo de candidatos da base própria para NÃO acionar o MCP de CNPJ.
# STUDIO_CAPTURE_MIN_OWN="20"
# Limite diário de leads NOVOS capturados por org (zero à meia-noite no
# fuso OUTREACH_TIMEZONE). Conservador de propósito (D2).
# STUDIO_CAPTURE_DAILY_LIMIT="200"

# ─── Embeddings da captura (D1, studio/ai/embeddings.js) ────────────
# Usa o MESMO gateway LiteLLM do chat (LITELLM_URL/LITELLM_API_KEY acima).
# Sem LITELLM_URL a busca roda lexical-only (degradação explícita no card).
# Modelo de embedding do publisher (cnpj-data-publisher; 1536 dims).
# STUDIO_EMBEDDING_MODEL="gemini-embedding"
# Timeout por chamada de embeddings, em ms.
# STUDIO_EMBEDDING_TIMEOUT_MS="20000"
# Backfill dos vetores no boot (jobs/embeddings-backfill): "off" desabilita.
# STUDIO_EMBEDDINGS_BACKFILL="true"
# Tamanho do lote (teto 128) e teto de linhas por execução do backfill.
# STUDIO_EMBEDDING_BACKFILL_BATCH="128"
# STUDIO_EMBEDDING_BACKFILL_MAX_ROWS="500"

# ─── Auto-cura da sessão WhatsApp (2026-10-19) ──────────────────────
# Intervalo do sweep que reconcilia o status das contas com o WAHA e religa
# sessões caídas (FAILED → restart; STOPPED/DISCONNECTED → start; QR_REQUIRED
# intocado). A 1ª cura roda no boot; o padrão é 300000 ms (5 min) com floor
# mínimo de 30000 ms (30 s). WAHA inalcançável nunca muda status.
# WHATSAPP_RECONCILE_MS="300000"

# ── Gmail OAuth (envio de fotos / outreach por Gmail) ────────────────────────
# Google Cloud Console → APIs e Serviços → Credenciais → "ID do cliente OAuth 2.0"
# (Tipo: Aplicativo da Web). Redirect autorizado:
#   http://localhost:3001/api/gmail/callback        (dev)
#   https://SEU-DOMINIO/api/gmail/callback          (produção)
# Escopos usados pelo app: gmail.send + gmail.metadata (mínimos p/ enviar e
# detectar respostas). API "Gmail API" precisa estar HABILITADA no projeto.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# ── Origem pública da aplicação ──────────────────────────────────────────────
# Usada nos links/imagem dos e-mails e como fallback do redirect do OAuth do
# Gmail (o redirect prioritário é a origem do frontend capturada no clique).
# Dev (frontend no Vite): http://localhost:5173   · Produção: https://SEU-DOMINIO
# APP_URL=http://localhost:5173

# ── Destino canônico do botão de contato (2026-10-29) ───────────────────────
# O botão "fale com a empresa" do e-mail SEMPRE aponta para este WhatsApp
# (cadeia: link real do dono > WhatsApp dos materiais > ESTE padrão).
# Placeholder de exemplo (exemplo.com.br…) é normalizado para cá no backend.
# WHATSAPP_CTA_URL="https://wa.me/5512996399943"

# ── Publicação de imagens em bucket/CDN (OPCIONAL, produção) ────────────────
# Quando o servidor NÃO é alcançável pela internet, publique as imagens do
# Studio em um destino externo por HTTP PUT (Cloudflare R2 API, MinIO
# gateway, CDN com upload). As TRÊS vars juntas ativam; qualquer falha cai
# no fallback local (rota /media) sem quebrar o envio.
# MEDIA_PUBLISH_PUT_URL="https://api.cloudflare.com/client/v4/accounts/<acct>/r2/buckets/<bucket>/objects/{fileName}"
# MEDIA_PUBLISH_AUTH="Bearer <token>"
# MEDIA_PUBLISH_PUBLIC_BASE="https://cdn.seudominio.com"

# ── Relay Cloudflare para fetch bloqueado (OPCIONAL) ────────────────────────
# Alguns hosts (caso real: imgur) devolvem 429/403 ao IP do servidor. Com o
# Worker b2base-media-relay publicado (cloudflare/media-relay/README.md), o
# resolvedor de imagem tenta UMA vez pelo relay — o Cloudflare busca na edge
# e devolve página/bytes. As DUAS vars juntas ativam; sem elas o bloqueio
# vira erro honesto no card (o auto-cura tenta de novo no próximo sweep).
# MEDIA_FETCH_RELAY_URL="https://b2base-media-relay.<subdominio>.workers.dev"
# MEDIA_FETCH_RELAY_AUTH="Bearer <segredo do worker (RELAY_AUTH)>"


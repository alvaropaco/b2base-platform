// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  cnpj      String?    @unique
  plan      String     @default("trial") // trial | premium
  // ── Billing Stripe (assinatura do plano premium) ──
  // O plano acompanha o ciclo de vida da assinatura via webhook
  // (stripe-billing.js): active/trialing/past_due = premium.
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePlanStatus     String?  // active, trialing, past_due, canceled…
  // ── Studio Cockpit (011): pausa global de emergência (FR-19, AD-4) ──────
  // Estado PERSISTIDO checado no gate a montante de todo envio — nunca só
  // em memória; retomada exige ação explícita.
  studioSendPaused     Boolean  @default(false)
  studioPausedAt       DateTime?
  studioPausedById     String?
  studioPauseReason    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  users     User[]
  prospects Prospect[]
  activities Activity[]
  workflows Workflow[]
  enrichmentRequests EnrichmentRequest[]
  csvMappingMemories CsvMappingMemory[]
  commercialSettings CommercialSettings?
  deepAnalyses DeepAnalysis[]
}

model CommercialSettings {
  id                  String   @id @default(cuid())
  orgId               String   @unique
  organization        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(0)
  companyName         String?
  salesTeamSize       String?
  targetSegments      Json     @default("[]")
  targetCnaes         Json     @default("[]")
  targetLocations     Json     @default("[]")
  companyStatuses     Json     @default("[\"active\"]")
  targetSizes         Json     @default("[]")
  ageRanges           Json     @default("[]")
  averageTicket       Int?
  salesCycle          String?
  valueProposition    String?
  // ── Contexto de negócio da org usado pela IA (org-context.js) ──────────
  // Fonte do pilar 1: produto, modelo de negócio, diferenciais, site/CTA.
  // Campos opcionais: o que não estiver preenchido a IA NÃO afirma.
  productDescription  String?  // o que a empresa vende (produto/serviço)
  businessModel       String?  // como a empresa ganha dinheiro
  differentiators     Json     @default("[]") // diferenciais (array de strings)
  websiteUrl          String?  // site público (CTA default dos agentes)
  ctaGoal             String?  // o que a IA deve conduzir o lead a fazer
  toneNotes           String?  // tom de voz desejado (opcional)
  // ── Onboarding conversacional (009): conta nasce configurada ───────────
  crmName             String?  // CRM declarado na conversa (null = não usa/não informado)
  onboardingAnswers   Json?    // registro completo das respostas da conversa
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([orgId])
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  phone    String?
  role     String   @default("member")
  orgId    String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Incremented on logout so previously issued session tokens are rejected,
  // even though they are stateless JWTs.
  sessionVersion Int @default(0)
  // Última atividade do usuário na plataforma (request autenticada).
  // Atualizado com throttle no requireAuth (~1x/60s por usuário) para
  // evitar write excessivo; exposto no painel admin (admin/users).
  lastActiveAt DateTime?
  // Bloqueio do usuário pelo admin: quando não-nulo, toda request
  // autenticada do usuário é rejeitada (efeito imediato, incluindo
  // sessões já existentes). null = ativo.
  blockedAt DateTime?
}

model Prospect {
  id                    String   @id @default(cuid())
  // ── Identidade e chaves de enriquecimento ──────────────────────────────
  // A identidade do lead é o `id`; o CNPJ é apenas UMA das chaves que os
  // pipelines de enriquecimento conseguem consumir (domain é a outra). Leads
  // importados sem CNPJ ficam com cnpj null e status 'lead' até terem uma
  // chave (informada pelo usuário ou resolvida contra a base RFB).
  cnpj                  String?
  taxIdType             String?  @default("br_cnpj") // br_cnpj | us_ein | eu_vat | ...
  domain                String?                      // site — chave universal de enriquecimento B2B
  importKey             String?                      // dedup idempotente de imports (email ou nome+cidade)
  contactName           String?                      // pessoa de contato do lead (import CSV / PDL)
  logoUrl               String?                      // logo da empresa (enriquecimento premium)
  companyName           String
  tradeName             String?
  status                String   @default("prospect") // prospect, deep_analysis, qualified, discarded, closed (lead removido na 005 — ver scripts/backfill-lead-status.js)
  opportunityScore      Int      @default(0)
  revenueEstimate       Int?
  employees             Int?
  industry              String?
  // Epic 1 (FR4): industry+companyName+tradeName em caixa baixa e SEM acento
  // (search-text.js) — matching de segmento tolerante a acento/grafia.
  // Backfill idempotente na migração; mantido nos hooks de escrita.
  searchText            String?
  city                  String?
  state                 String?
  cnpjEmail             String?
  cnpjPhones            Json?
  cnpjPartners          Json?
  cnpjRawData           Json?
  cnpjOpenedAt          DateTime?
  cnpjLegalNature       String?
  enrichmentStatus      String   @default("pending") // pending, enriched, unavailable, error
  enrichmentSource      String?
  enrichmentError       String?
  enrichmentVersion     Int      @default(0)
  enrichmentSummary     Json?
  enrichedAt            DateTime?
  // ── Análise profunda de IA (feature 005) ──────────────────────────────────
  // Estado do card no kanban; a análise vigente é apontada por
  // currentDeepAnalysisId (histórico fica retido em DeepAnalysis).
  analysisStatus        String   @default("not_started") // not_started, running, completed, failed
  verdict               String?  // contact | no_contact — veredito da análise vigente (denormalizado p/ o kanban)
  currentDeepAnalysisId String? @unique
  currentDeepAnalysis   DeepAnalysis? @relation("ProspectCurrentAnalysis", fields: [currentDeepAnalysisId], references: [id], onDelete: SetNull)
  deepAnalyses          DeepAnalysis[]
  activitiesCount       Int      @default(0)
  lastContact           DateTime?                     // timestamp do 1º envio real (email/whatsapp)
  contactedChannels     Json     @default("[]")       // ["email","whatsapp"] — badge "Contatado"
  qualificationStage    String   @default("initial_contact")
  creditRiskScore       Int?
  creditRiskLevel       String?
  orgId                 String
  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  activities            Activity[]
  enrichmentRequests    EnrichmentRequest[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Unicidade POR ORG (não global): dois clientes do B2Base podem prospectar
  // a mesma empresa. cnpj null não conflita (Postgres trata NULL como distinto).
  @@unique([orgId, cnpj])
  @@unique([orgId, importKey])
  @@index([orgId])
  @@index([status])
  @@index([createdAt])
  @@index([enrichedAt])
  @@index([enrichmentStatus])
}

// Análise profunda de lead por IA (feature 005): UMA LINHA POR EXECUÇÃO.
// A vigente é apontada por Prospect.currentDeepAnalysisId — a reexecução cria
// nova linha e move o ponteiro, retendo o histórico (specs/005-deep-lead-
// analysis/data-model.md). Dados que NUNCA estão aqui: contato cru do lead.
model DeepAnalysis {
  id                      String   @id @default(cuid())
  prospectId              String
  orgId                   String   // sempre = prospect.orgId (isolamento FR-016)
  status                  String   @default("running") // running, completed, failed
  modelVersion            String?  // modelo/alias efetivamente usado
  finalScore              Int?     // 0–100 — obrigatório quando completed
  verdict                 String?  // contact | no_contact — obrigatório quando completed
  summary                 String?  // resumo completo com as impressões da IA
  impressions             Json     @default("[]") // impressões da IA (lista de strings)
  factorsPro              Json     @default("[]")
  factorsCon              Json     @default("[]")
  deterministicScore      Int?     // opportunityScore no momento da análise (referência FR-008)
  contactDecisionSnapshot Json?    // painel de decisão 003 usado como evidência
  orgContextConsidered    Boolean  @default(false) // false ⇒ contexto da org ausente (FR-017)
  override                Boolean  @default(false) // veredito negativo superado por humano
  errorMessage            String?  // motivo da falha (status = failed)
  enrichmentVersion       Int      @default(0) // versão do enriquecimento analisada (idempotência)
  createdAt               DateTime @default(now())
  completedAt             DateTime?

  prospect   Prospect    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  currentForProspect Prospect? @relation("ProspectCurrentAnalysis")

  @@index([prospectId])
  @@index([orgId, createdAt])
}

// Ledger de pedidos de enriquecimento: correlaciona o event_id publicado no
// NATS com o prospect/org de origem. O resultado volta com request_event_id,
// o que permite rotear corretamente mesmo com o mesmo CNPJ em vários orgs
// (e dá auditoria do que foi pedido a cada provider).
model EnrichmentRequest {
  id         String   @id @default(cuid())
  eventId    String   @unique
  orgId      String
  prospectId String
  cnpj       String?
  taxIdType  String?
  provider   String   @default("nats.br_cnpj.v1")
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  prospect     Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([orgId])
}

// Memória de mapeamento de imports CSV por org: lembra como as planilhas do
// cliente foram mapeadas para reusar como referência (few-shot) nos próximos
// imports. Guarda APENAS nomes de colunas + mapeamento aceito — nunca os
// valores das linhas (dados de leads não ficam aqui).
model CsvMappingMemory {
  id              String   @id @default(cuid())
  orgId           String
  headerSignature String   // colunas normalizadas, ordenadas e concatenadas
  headers         Json     // cabeçalhos originais da planilha
  mapping         Json     // mapeamento aceito (final, pós-auditoria)
  useCount        Int      @default(1)
  lastUsedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, headerSignature])
  @@index([orgId])
}

model Activity {
  id         String   @id @default(cuid())
  type       String   // call, email, meeting, note
  description String?
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([prospectId])
  @@index([orgId])
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  trigger     String   // prospect_created, score_changed, etc
  action      String   // send_email, create_task, etc
  status      String   @default("active")
  orgId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([orgId])
}

// Resultados do pipeline de enriquecimento via NATS (enrichment.company.completed.v1).
// A chave única (companyId, enrichmentVersion) torna a persistência idempotente,
// garantindo que a mesma mensagem at-least-once não duplique dados.
model CnpjEnrichment {
  id               String    @id @default(cuid())
  companyId        String                       // uuid determinístico derivado do CNPJ
  cnpj             String
  enrichmentVersion Int     @default(1)
  requestEventId   String?
  status           String    @default("COMPLETED") // COMPLETED, PARTIAL, FAILED, DISCARDED
  errorCode        String?
  errorMessage     String?
  companyName      String?
  tradeName        String?
  industry         String?
  revenueEstimate  Int?
  employees        Int?
  cnpjEmail        String?
  cnpjPhones       Json?
  cnpjPartners     Json?
  cnpjOpenedAt     DateTime?
  cnpjLegalNature  String?
  score            Int?
  rawPayload       Json?
  // Rastreabilidade do org/prospect atendido (preenchido quando o resultado
  // foi correlacionado via ledger EnrichmentRequest). O log em si é por
  // empresa: a idempotência POR PROSPECT fica na enrichmentVersion do Prospect.
  orgId            String?
  prospectId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([companyId, enrichmentVersion])
  @@index([cnpj])
  @@index([status])
  @@index([orgId])
  @@index([prospectId])
}

// ============================================================================
// COLD SALES AUTOMATICO — Outreach via Gmail
// ============================================================================

// Conta de email conectada ao cliente para envio de outreach.
// provider: "gmail" (OAuth API), "smtp" (ex.: Gmail com App Password), "resend" (API HTTP).
model EmailAccount {
  id                      String   @id @default(cuid())
  tenantId                String                         // organization.id
  userId                  String                         // user.id (dono da conta)
  provider                String    @default("gmail")     // gmail, smtp, resend
  email                   String                         // endereço de envio (From)
  encryptedRefreshToken   String?                         // gmail: refresh token OAuth
  encryptedSecret         String?                         // smtp: password/app password · resend: api key
  smtpHost                String?                         // smtp: ex.: smtp.gmail.com
  smtpPort                Int?                           // smtp: ex.: 587 (STARTTLS) ou 465 (TLS)
  smtpSecure              Boolean   @default(false)      // smtp: true quando porta 465
  fromName                String?                         // nome amigável do remetente (opcional)
  scopes                  Json      @default("[]")        // ["gmail.send", "gmail.metadata"] (provider gmail)
  status                  String    @default("connected") // connected, revoked, expired, error
  lastHistoryId           String?                         // token da última consulta do history (provider gmail)
  // ── Studio Cockpit (011): autenticação de domínio verificada (AD-8, FR-16)
  sendingDomain           String?                         // domínio de envio (parte após @ de `email`)
  domainAuthStatus        String?                         // unverified | verified | failed (DNS real, nunca checkbox)
  domainAuthDetail        Json?                           // {spf, dkim, dmarc} — última verificação
  domainAuthVerifiedAt    DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  contacts                OutreachContact[]

  @@index([tenantId])
  @@index([userId])
  @@index([email])
}

// Campanha de outreach (agrupa contactos).
model OutreachCampaign {
  id          String   @id @default(cuid())
  tenantId    String                         // organization.id
  name        String
  description String?
  // Proposta comercial da campanha (pilar 2 dos prompts de IA).
  objective   String?  // objetivo da campanha (ex.: agendar call, cadastro self-service)
  offer       String?  // proposta/oferta: o que oferecer ao lead nesta campanha
  status      String   @default("draft")     // draft, active, paused, completed

  // ── Suíte multicanal (gatilho pós-enriquecimento) ──────────────────
  // trigger=on_enrichment + autoActive: assim que o enriquecimento do lead
  // conclui, dispara os canais selecionados com os templates configurados.
  trigger                String   @default("manual")  // manual | on_enrichment
  source                 String   @default("manual")  // manual | ai (criada pelo gerador de campanha IA)
  channels               Json     @default("[]")      // ["email", "whatsapp"]
  autoActive             Boolean  @default(false)     // automação ligada?
  emailAccountId         String?                      // conta de envio do disparo automático
  emailTemplateSubject   String?                      // placeholders {{companyName}}, {{firstName}}, {{city}}, {{industry}}
  emailTemplateBody      String?                      // texto plano (email single-shot quando template custom)
  // ── Studio Cockpit (011, FR-37/AD-2): headers de descadastro one-click ──
  // Definidos no compile do bridge (nunca nos workers): List-Unsubscribe e
  // List-Unsubscribe-Post (RFC 8058) da execução de e-mail compilada.
  emailHeaders           Json?
  whatsappAccountId      String?                      // conta WAHA do disparo automático
  whatsappTemplate       String?                      // mensagem WhatsApp (mesmos placeholders)
  autoWhatsAppCampaignId String?                      // WhatsAppCampaign criada p/ automação (reusada)
  // ── Campaign Studio (specs/010) — colunas aditivas ──────────────────────
  // Link reverso da execução de e-mail → campanha Studio (studio/campaign-routes).
  studioCampaignId String? @unique
  // Guard-rails da automação opt-in (clarify 010): aprovação do 1º lote,
  // pausa por anomalia — preenchido quando a suíte é gerida pelo Studio.
  guardrails Json @default("{}")
  // Follow-ups simples configuráveis (FR-079 010): [{stepIndex, delayDays,
  // condition, maxTouch}]. Vazio = sequência legada [3,5,7].
  sequence Json @default("[]")
  // ── Onda "criação sem bloqueios" (D8) — anexos por REFERÊNCIA ──────────
  // Referências [{attachmentId, fileName, originalName, mimeType, sizeBytes}]
  // re-resolvidas NA LIBERAÇÃO de cada lote (channel-bridge D6); os bytes são
  // lidos do storage do Studio no send (fail-safe). Nada de base64 em JSONB.
  studioAttachments Json @default("[]")
  // ── Governança de template (007) ─────────────────────────────────────────
  needsReview  Boolean  @default(false) // retida pelo saneamento (template com texto interno)
  reviewReason String?                  // motivo da retenção (ex.: synthetic_template_leak)
  approvedAt   DateTime?                // aprovação da mensagem base pelo tenant (fluxo IA)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts    OutreachContact[]

  @@index([tenantId])
  @@index([status])
}

// Relação entre um lead/prospect e uma campanha de outreach.
model OutreachContact {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospectId        String                         // prospect.id
  emailAccount_id       String?
  emailAccount          EmailAccount? @relation(fields: [emailAccount_id], references: [id])
  status                String   @default("SELECTED") // SELECTED → QUEUED → GENERATING → SCHEDULED → SENDING → SENT → DELIVERED_INFERRED → OPENED_INFERRED → REPLIED
  // States parallel: BOUNCED, FAILED, UNSUBSCRIBED, CANCELLED
  outreachSequence  Int      @default(1)           // 1=primeiro email, 2=follow-up, ...
  scheduledAt       DateTime?                      // quando deve ser enviado
  sentAt            DateTime?
  nextFollowupAt    DateTime?
  lastReplyAt       DateTime?                      // ultima resposta do lead
  replyCount        Int      @default(0)
  unsubscribed      Boolean  @default(false)
  cancelReason      String?                        // replied, unsubscribed, bounced, cancelled
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages          OutreachMessage[]
  events            OutreachEvent[]

  @@unique([prospectId, campaignId])
  @@index([campaignId])
  @@index([prospectId])
  @@index([status])
}

// Modelo de mensagem reutilizavel dentro de campanhas.
model OutreachTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  subject     String
  body        String    // texto base (sem tracking pixel)
  htmlBody    String?   // versão HTML com placeholder do pixel
  status      String   @default("draft")  // draft, active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    OutreachMessage[]

  @@index([tenantId])
}

// Mensagem individual gerada/encaminhada para um contacto.
model OutreachMessage {
  id                String   @id @default(cuid())
  contactId         String
  contact           OutreachContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  templateId        String?
  template          OutreachTemplate? @relation(fields: [templateId], references: [id])
  subject           String
  body              String    // texto plain
  htmlBody          String?   // HTML com pixel de tracking
  gmailMessageId    String?   // id retornado pela Gmail API
  gmailThreadId     String?
  messageHeaderId   String?   // Message-ID header
  status            String   @default("GENERATING") // GENERATING → SCHEDULED → SENDING → SENT
  error             String?
  generatedAt       DateTime?
  scheduledFor      DateTime?
  sentAt            DateTime?
  trackingToken     String?   // uuid para pixel
  aiReasoningFacts  Json?    // fatos usados pela IA
  compositionOrigin String?  // tenant_template | ai | profile_base — auditoria da composição (007)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events            OutreachEvent[]

  @@index([contactId])
  @@index([status])
  @@index([trackingToken])
  @@index([gmailMessageId])
}

// Eventos que constroem a timeline do lead.
model OutreachEvent {
  id           String   @id @default(cuid())
  contactId    String?
  contact      OutreachContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messageId    String?
  message      OutreachMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type         String   // email_scheduled, email_sent, email_delivered_inferred, email_opened_inferred, email_replied, email_bounced, email_failed, email_unsubscribed, email_cancelled, followup_scheduled, followup_sent
  status       String
  details      Json?    // dados adicionais (gmail ids, timestamp, etc)
  createdAt    DateTime @default(now())

  @@index([contactId])
  @@index([messageId])
  @@index([type])
  @@index([createdAt])
}

// Lista de emails/endereços para não enviar (unsubscribe + suppression).
model SuppressionList {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  reason    String?  // unsubscribed, bounce, manual
  addedAt   DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ============================================================================
// WHATSAPP — Prospecção E2E via WAHA (WhatsApp HTTP API)
// ============================================================================

// Conta WhatsApp conectada ao workspace através do WAHA.
// Não armazena credenciais: a API key do WAHA vive apenas no ambiente do servidor.
model WhatsAppAccount {
  id          String   @id @default(cuid())
  orgId       String                         // organization.id
  userId      String                         // user.id (dono da conta)
  provider    String   @default("waha")      // waha
  sessionName String   @unique               // nome determinístico da sessão WAHA
  phoneNumber String?
  status      String   @default("CREATED")   // CREATED, STARTING, QR_REQUIRED, CONNECTED, DISCONNECTED, STOPPED, ERROR
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns     WhatsAppCampaign[]
  conversations WhatsAppConversation[]

  @@index([orgId])
  @@index([userId])
}

// Campanha de prospecção via WhatsApp (agrupa leads e sequência de etapas).
model WhatsAppCampaign {
  id                String   @id @default(cuid())
  orgId             String                         // organization.id
  name              String
  // Proposta comercial da campanha (pilar 2 dos prompts de IA). Alimenta o
  // reply agent quando o lead responde a uma mensagem da campanha.
  objective         String?  // objetivo da campanha
  offer             String?  // proposta/oferta: o que oferecer ao lead
  ctaUrl            String?  // link/ação que a campanha conduz (default: site da org)
  whatsappAccountId String?
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  status            String   @default("DRAFT")     // DRAFT, SCHEDULED, RUNNING, PAUSED, COMPLETED, CANCELLED
  source            String   @default("manual")    // manual | ai (criada pelo gerador de campanha IA)
  startedAt         DateTime?
  pausedAt          DateTime?
  completedAt       DateTime?
  // ── Governança de template (007) ─────────────────────────────────────────
  needsReview  Boolean  @default(false) // retida pelo saneamento (template com texto interno)
  reviewReason String?                  // motivo da retenção (ex.: synthetic_template_leak)
  approvedAt   DateTime?                // aprovação da mensagem base pelo tenant (fluxo IA)
  // ── Campaign Studio (specs/010) — colunas aditivas ──────────────────────
  studioCampaignId String? @unique // link reverso da execução WhatsApp → campanha Studio
  guardrails Json @default("{}")   // guard-rails da automação opt-in (clarify 010)
  // ── Onda "criação sem bloqueios" (D8) — mídia por REFERÊNCIA ───────────
  // Referência [{attachmentId, fileName, originalName, mimeType, sizeBytes}]
  // da mídia escolhida (D6: mais antiga por createdAt), re-resolvida NA
  // LIBERAÇÃO de cada lote; bytes lidos do storage no send. Sem base64.
  studioAttachments Json @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  steps    WhatsAppSequenceStep[]
  contacts WhatsAppCampaignContact[]

  @@index([orgId])
  @@index([status])
}

// Etapa da sequência de mensagens de uma campanha (mensagem + delay + condições).
model WhatsAppSequenceStep {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  orderIndex      Int      @default(0)
  messageTemplate String                           // fallback garantido quando aiPersonalized (render de template)
  aiPersonalized  Boolean  @default(false)         // gera mensagem única por lead com IA (falha → messageTemplate)
  delayMinutes    Int      @default(0)             // delay em minutos antes deste step
  conditions      Json     @default("[]")          // condições opcionais (ex.: só enviar se lead abriu)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([campaignId, orderIndex])
  @@index([campaignId])
}

// Relação lead ↔ campanha: âncora de idempotência e progresso da sequência.
model WhatsAppCampaignContact {
  id               String   @id @default(cuid())
  campaignId       String
  campaign         WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospectId       String
  phoneNumber      String?
  status           String   @default("QUEUED")     // QUEUED → SENDING → SENT → REPLIED | CANCELLED, OPTED_OUT
  currentStepIndex Int      @default(0)
  lastSentAt       DateTime?
  nextSendAt       DateTime?
  cancelReason     String?                          // replied, opted_out, do_not_contact, cancelled
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([campaignId, prospectId])
  @@index([prospectId])
  @@index([status])
}

// Conversa 1:1 com um lead via WhatsApp (inbox).
model WhatsAppConversation {
  id                   String   @id @default(cuid())
  orgId                String
  whatsappAccountId    String?
  whatsappAccount      WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  prospectId           String?
  phoneNumber          String
  // JID original do WhatsApp (ex.: "8508...@lid", "1203...@g.us"). O envio
  // deve preferir este campo: reconstruir "<digits>@c.us" do phoneNumber
  // falha silenciosamente para chats LID/grupo.
  chatId               String?
  status               String   @default("ACTIVE") // ACTIVE, PAUSED, HUMAN_HANDOFF, CLOSED, OPTED_OUT
  lastMessageAt        DateTime?
  lastInboundMessageAt DateTime?
  // Reengajamento automático (agente de IA). Sem máquina de estados: o estado
  // é derivado do histórico (última mensagem outbound sem resposta + cooldown).
  reengageAttempts     Int      @default(0) // tentativas no ciclo atual (resposta do lead zera)
  reengageTotal        Int      @default(0) // teto vitalício anti-insistência
  lastReengageAt       DateTime?            // última decisão/envio do agente (gate de gap mínimo)
  automationPausedAt   DateTime?            // kill switch manual por conversa
  assignedTo           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  messages WhatsAppMessage[]

  @@unique([orgId, phoneNumber])
  @@index([orgId])
  @@index([prospectId])
  @@index([status])
}

// Mensagem individual (enviada ou recebida). providerMessageId é único por
// conversa → dedup de eventos at-least-once do webhook.
model WhatsAppMessage {
  id                String   @id @default(cuid())
  conversationId    String
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  orgId             String
  campaignContactId String?
  direction         String                           // INBOUND, OUTBOUND
  type              String   @default("TEXT")        // TEXT, IMAGE, DOCUMENT, AUDIO, VIDEO, LOCATION
  content           String?
  mediaUrl          String?
  providerMessageId String?
  status            String   @default("PENDING")     // PENDING, SENT, DELIVERED, READ, FAILED
  source            String   @default("MANUAL")      // MANUAL, CAMPAIGN, REENGAGEMENT
  compositionOrigin String?                          // tenant_template | ai | ai_fallback_template | profile_base (007)
  stepIndex         Int?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([conversationId, providerMessageId])
  @@unique([campaignContactId, stepIndex])
  @@index([conversationId])
  @@index([direction])
  @@index([status])
}

// Auditoria e fila de sugestões do agente de reengajamento. Cada decisão do
// agente (gerada, enviada, bloqueada pelo guard, recusada pela IA) vira um
// evento; no modo suggest, eventos GENERATED aguardam aprovação humana.
model WhatsAppReengagementEvent {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String
  prospectId     String?
  attempt        Int      @default(1)
  strategy       String?             // RETOMAR_CONTEXTO, VALOR_NOVO, REFRAME_E_ENCERRAMENTO
  reason         String?             // justificativa da IA / motivo do bloqueio
  content        String?             // mensagem gerada
  origin         String?             // ai | fallback
  mode           String              // shadow | suggest | auto (modo vigente na decisão)
  status         String              // GENERATED, SENT, APPROVED, DISCARDED, BLOCKED_GUARD, REFUSED_IA, CANCELLED_INBOUND, FAILED
  sentMessageId  String?
  // Auditoria do contexto usado na geração (org configurada? campanha de origem?).
  context        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId, status, createdAt])
  @@index([conversationId])
}

// Estado de engajamento do lead POR CANAL (whatsapp, email, linkedin, ...).
// Permite opt-out / do-not-contact do WhatsApp sem afetar os demais canais e
// sem duplicar o cadastro do lead (que permanece no modelo Prospect).
model LeadChannelState {
  id          String   @id @default(cuid())
  orgId       String
  prospectId  String
  channel     String   @default("whatsapp")          // whatsapp, email, linkedin
  status      String   @default("active")            // active, opted_out, do_not_contact
  phoneNumber String?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([prospectId, channel])
  @@index([orgId])
  @@index([channel])
  @@index([status])
}

// ════════════════════════════════════════════════════════════════════════════
// Motor de enriquecimento distribuído (specs/001-distributed-enrichment).
// Isolamento por organização (orgId) em todas as entidades — constituição IV.
// Contratos NATS versionados *.v1 em specs/001-distributed-enrichment/contracts/.
// ════════════════════════════════════════════════════════════════════════════

// Operação completa de enriquecimento de um lead. Um prospect pode ter vários
// jobs ao longo do tempo; `plan` é snapshot do plano no momento do job.
model EnrichmentJob {
  id          String    @id @default(cuid())
  orgId       String
  prospectId  String
  // PENDING | RUNNING | DEGRADED | PARTIAL | COMPLETED | FAILED | CANCELLED
  // DEGRADED (006): aguardando tasks PARKED — não-terminal, refinaliza depois.
  status      String    @default("PENDING")
  // manual | api | csv_import | qualification_stage | discovery
  trigger     String
  plan        String    // trial | premium (snapshot — gating é avaliado no planejamento)
  engine      String    @default("v2")
  startedAt   DateTime?
  completedAt DateTime?
  lastError   Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks EnrichmentTask[]

  @@index([orgId, createdAt])
  @@index([prospectId, createdAt])
}

// Unidade fundamental de execução distribuída: job + entidade + capability.
// Idempotente por `taskKey` (uuidv5 determinístico) — redelivery/replanejamento
// não duplicam estado. `dependsOn` forma o DAG mínimo (FR-012).
model EnrichmentTask {
  id              String    @id @default(cuid())
  orgId           String
  jobId           String
  prospectId      String
  taskKey         String    @unique
  entityKey       String // ex.: "prospect:cls…", "domain:exemplo.com.br"
  entityType      String // prospect | company | person | domain | email | phone | social_profile | product | article
  capability      String
  provider        String?
  input           Json
  inputHash       String
  // PENDING | QUEUED | RUNNING | PARKED | COMPLETED | FAILED | RETRY | TIMEOUT | BLOCKED | CANCELLED | SKIPPED
  // PARKED (006): erro transiente com tentativas esgotadas — aguardando o
  // sweeper re-publicar. NUNCA termina FAILED por erro transitório (FR-001).
  status          String    @default("PENDING")
  priority        Int       @default(2) // 0=highest … 3=background
  attempt         Int       @default(0)
  maxAttempts     Int       @default(3)
  timeoutMs       Int       @default(30000)
  dependsOn       String[]  @default([])
  depth           Int       @default(0) // profundidade de expansão dinâmica
  spawnedByTaskId String? // rastreabilidade da expansão (FR-013)
  startedAt       DateTime?
  completedAt     DateTime?
  // ── Resiliência (feature 006) ─────────────────────────────────────────────
  nextAttemptAt   DateTime? // agendamento do sweeper (retryAfterMs/plateau)
  parkedAt        DateTime? // quando entrou em PARKED
  parkCycles      Int       @default(0) // ciclos parked já contados
  lastError       Json? // { type, message, provider, attempt }
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  job    EnrichmentJob    @relation(fields: [jobId], references: [id])
  result EnrichmentResult?
  retryEvents EnrichmentTaskRetryEvent[]

  @@index([jobId, status])
  @@index([status, priority])
  @@index([orgId, prospectId])
  @@index([status, nextAttemptAt])
}

// Auditoria de retries parked (feature 006, FR-007): um ciclo = uma linha.
// Dedup de re-publicação do sweeper: publishedAt IS NULL = ciclo vigente.
model EnrichmentTaskRetryEvent {
  id           String    @id @default(cuid())
  taskId       String
  orgId        String
  cycle        Int
  errorType    String
  provider     String?
  message      String?
  scheduledFor DateTime
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  task EnrichmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, cycle])
  @@index([orgId, createdAt])
}

// Registro/dedup de notificações à operação (feature 006, FR-014..017).
model OpsNotification {
  id          String   @id @default(cuid())
  dedupKey    String   @unique
  kind        String   // task_failed | circuit_open | park_expired | digest
  severity    String   @default("warning") // critical | warning | info
  orgId       String?
  title       String
  payload     Json
  channels    Json     @default("[]")
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Resultado final persistido PELO WORKER (um por task; retentativas sobrescrevem
// via upsert por taskId). Persistido antes do ack (FR-004/FR-018).
model EnrichmentResult {
  id            String   @id @default(cuid())
  orgId         String
  taskId        String   @unique
  jobId         String
  prospectId    String
  entityKey     String
  entityType    String
  capability    String
  provider      String?
  // COMPLETED | FAILED
  status        String
  data          Json? // fatos normalizados canônicos
  confidence    Float?
  durationMs    Int
  workerVersion String
  rawRecordId   String?
  // Metadados extras (ex.: reprocessedFrom no reprocessamento de bruto — T044)
  metadata      Json?
  createdAt     DateTime @default(now())

  task     EnrichmentTask      @relation(fields: [taskId], references: [id])
  evidence EnrichmentEvidence[]

  @@index([orgId, prospectId])
  @@index([jobId])
}

// Prova de origem POR FATO (FR-026): responde "de onde veio, quando, com quanta
// confiança". Valores conflitantes de fontes distintas COEXISTEM (FR-029).
model EnrichmentEvidence {
  id          String   @id @default(cuid())
  orgId       String
  resultId    String
  attribute   String // ex.: company.employeeCount
  value       Json
  sourceType  String // searxng | brasilapi | rfb | pdl | clearbit | dns …
  provider    String?
  url         String?
  retrievedAt DateTime
  confidence  Float?
  rawRecordId String?
  createdAt   DateTime @default(now())

  result EnrichmentResult @relation(fields: [resultId], references: [id])

  @@index([orgId, attribute])
}

// Dado bruto retido (camada separada do normalizado — FR-027/028). Backend
// inicial Postgres atrás da abstração raw-store.js; S3/MinIO ativável depois
// (research R5) via storageBackend/storageRef.
model RawRecord {
  id             String   @id @default(cuid())
  orgId          String
  capability     String
  provider       String
  contentType    String // application/json | text/html | text/plain
  sizeBytes      Int
  payload        String? // preenchido quando storageBackend=postgres
  storageBackend String   @default("postgres")
  storageRef     String?
  truncated      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([orgId, capability, createdAt])
}

// Cache de geocodificação de endereços de leads (feature 002). Compartilhado
// entre organizações: endereço não é dado de tenant — o masking por plano
// acontece na leitura (geocoding.js: trial recebe só o resumo cidade/UF).
model GeocodeCache {
  id            String   @id @default(cuid())
  normalizedKey String   @unique
  lat           Float
  lng           Float
  precision     String // street | zip | city
  source        String // brasilapi | nominatim
  fetchedAt     DateTime @default(now()) // base do TTL de 90 dias
}

// ── Discovery Engine (specs/006-discovery-engine) ───────────────────────────
// Pipeline discovery → enrichment → intelligence. Entidade canônica +
// perfis por domínio + evidência imutável; nada de colunas nullable por
// provider no DiscoveryEntity (data-model.md, princípio 1).

// Job de descoberta: fan-out para providers, fan-in de observações.
model DiscoveryJob {
  id             String    @id @default(cuid())
  orgId          String
  // queued | running | partial | completed | failed | cancelled
  status         String    @default("queued")
  // api | prospect | manual
  trigger        String
  query          Json // { criteria, seed } — o que foi pedido
  providerConfig Json // snapshot de providers/limites (sem segredos)
  providersTotal  Int      @default(0)
  providersDone   Int      @default(0)
  providersFailed Int      @default(0)
  itemsFound      Int      @default(0)
  estimatedCost   Float    @default(0) // soma dos runs, em centavos
  lastError       Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  runs       DiscoveryProviderRun[]
  candidates DiscoveryCandidate[]

  @@index([orgId, createdAt])
}

// Execução de UM provider dentro do job (rate/custo/erro por provider).
model DiscoveryProviderRun {
  id            String    @id @default(cuid())
  orgId         String
  jobId         String
  provider      String
  capability    String
  // pending | running | completed | failed | skipped
  status        String    @default("pending")
  attempt       Int       @default(0)
  requests      Int       @default(0)
  items         Int       @default(0)
  estimatedCost Float     @default(0)
  errorCode     String?
  errorMessage  String?
  lastCursor    String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  job DiscoveryJob @relation(fields: [jobId], references: [id])

  @@unique([jobId, provider])
  @@index([orgId, status])
}

// Entidade canônica multi-tipo (company, person, domain, legal_case, …).
// Identidade = (orgId, type, canonicalKey) — redelivery NÃO duplica (SC-005).
model DiscoveryEntity {
  id           String   @id @default(cuid())
  orgId        String
  type         String
  canonicalKey String
  displayName  String?
  identifiers  Json     @default("{}")
  attributes   Json     @default("{}")
  confidence   Float    @default(0)
  // active | merged | archived
  status       String   @default("active")
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, type, canonicalKey])
  @@index([orgId, type, lastSeenAt])
}

// Relação tipada entre entidades (HAS_DOMAIN, OWNS, RAISED, …).
model DiscoveryRelationship {
  id           String    @id @default(cuid())
  orgId        String
  fromEntityId String
  toEntityId   String
  type         String
  confidence   Float     @default(0)
  metadata     Json      @default("{}")
  observedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([orgId, fromEntityId, toEntityId, type])
  @@index([orgId, fromEntityId])
  @@index([orgId, toEntityId])
}

// Prova de origem IMUTÁVEL por fato; conflitos COEXISTEM (FR-025).
// rawHash estável deduplica redelivery (SC-005).
model DiscoveryEvidence {
  id             String    @id @default(cuid())
  orgId          String
  jobId          String?
  providerRunId  String?
  entityId       String?
  relationshipId String?
  // official_registry | ct_log | dns | http | search | estimated | reported | inferred | funding | legal
  evidenceType   String
  sourceProvider String
  sourceUrl      String?
  sourceRef      String?
  observedValue  Json
  observedAt     DateTime?
  capturedAt     DateTime  @default(now())
  confidence     Float     @default(0)
  rawHash        String
  metadata       Json      @default("{}")

  @@unique([orgId, rawHash])
  @@index([orgId, entityId])
  @@index([providerRunId])
}

// Projeção de venda sobre a entidade canônica (importável para Prospect).
model DiscoveryCandidate {
  id                 String    @id @default(cuid())
  orgId              String
  jobId              String
  companyEntityId    String?
  cnpj               String?
  name               String?
  domain             String?
  location           Json?
  confidence         Float     @default(0)
  // discovered | imported | dismissed
  status             String    @default("discovered")
  dedupeKey          String
  evidenceCount      Int       @default(0)
  importedProspectId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  job DiscoveryJob @relation(fields: [jobId], references: [id])

  @@unique([orgId, dedupeKey])
  @@index([orgId, status, confidence])
}

// Sinal derivado de inteligência — NUNCA substitui a evidência de origem.
model DiscoverySignal {
  id              String    @id @default(cuid())
  orgId           String
  companyEntityId String
  type            String // recent_funding | expansion_signal | new_domain | hiring_signal | legal_risk_signal | technology_adoption
  value           Json      @default("{}")
  confidence      Float     @default(0)
  evidenceIds     String[]  @default([])
  observedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([orgId, companyEntityId, type])
  @@index([orgId, type, observedAt])
}

// ============================================================================
// CAMPAIGN STUDIO (specs/010) — camada de produto sobre os motores de canal.
// `StudioCampaign` orquestra; envio/tracking/reply permanecem nos motores
// Outreach*/WhatsApp* via studio/channel-bridge.js (research D1).
// ============================================================================

// A unidade central do Studio: conteúdo + audiência congelada + agenda +
// journey + experimentos. Estados e transições em studio/campaign-service.js.
model StudioCampaign {
  id          String   @id @default(cuid())
  orgId       String                            // organization.id
  name        String
  description String?
  // Proposta comercial da campanha (pilar 2 dos prompts de IA).
  objective   String?
  offer       String?
  funnelStage String   @default("middle")       // top | middle | bottom
  status      String   @default("draft")        // draft, in_review, approved, scheduled, running, paused, completed, cancelled, retained
  statusReason String?                          // motivo de retained/paused (sanimento 007, anomalia)
  origin      String   @default("manual")       // manual, ai_prompt, material, url, company_data, duplicate, template, agent
  sourceCampaignId String?                       // quando duplicate/variação: campanha original (nunca alterada)
  channels    Json     @default("[]")           // ["email","whatsapp","linkedin_text"]
  schedule    Json     @default("{}")           // {mode,startAt,windows,hourlyLimit,dailyLimit,timezone,useLeadTimezone}
  goalMetric  String?                           // métrica-objetivo do funil (analytics/ROI)
  convertedValue Int?                            // receita declarada por conversão (centavos)
  utmTemplate Json     @default("{}")           // {utmSource,utmMedium,utmCampaign}
  fallbackPolicy Json @default("{}")            // fallbacks por variável, política de fadiga/conflito
  approval    Json     @default("{}")           // {complianceLevel?, reviewNotes?} — parecer vigente
  approvedById String?                           // user.id — aprovação humana (FR-003 010)
  approvedAt  DateTime?
  emailExecutionId    String?                    // → OutreachCampaign (channel-bridge)
  whatsappExecutionId String?                    // → WhatsAppCampaign
  journeyEnabled Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  audienceSnapshots   StudioAudienceSnapshot[]
  contents            StudioContent[]
  attachments         StudioAttachment[]
  materials           StudioMaterial[]

  @@index([orgId])
  @@index([status])
}

// Segmento salvo e reutilizável: critérios estruturados sobre catálogo
// fechado de campos do lead, resolvidos por studio/segment-service.js.
model StudioSegment {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  criteria    Json                              // {version, groups:[{op:"AND"|"OR", conditions:[{field,op,value}]}]}
  naturalLanguageInput String?                  // pedido original quando criado por NL (FR-014 010)
  lastCount   Int?
  lastCountAt DateTime?
  createdBy   String                            // user.id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

// Audiência congelada no momento da aprovação (FR-013 010).
model StudioAudienceSnapshot {
  id             String   @id @default(cuid())
  orgId          String
  campaignId     String
  campaign       StudioCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  segmentId      String?                    // → StudioSegment quando derivada de segmento salvo
  criteriaVersion Json                     // critérios efetivos no congelamento (auditoria)
  totalCount     Int      @default(0)
  includedCount  Int      @default(0)
  excludedCount  Int      @default(0)
  status         String   @default("active") // active | superseded (sync-delta cria novo)
  createdAt      DateTime @default(now())

  members StudioAudienceMember[]

  @@index([campaignId])
}

// Linha por lead do snapshot: incluído/excluído + motivo + variante A/B.
model StudioAudienceMember {
  id                   String  @id @default(cuid())
  snapshotId           String
  snapshot             StudioAudienceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  prospectId           String
  included             Boolean @default(true)
  excludeReason        String?  // opt_out, suppressed, recent_contact, manual, fatigue, no_consent
  variantLabel         String?  // atribuição A/B determinística (experiment-service)
  excludedManuallyById String?  // user.id quando excludeReason = manual
  createdAt            DateTime @default(now())

  @@unique([snapshotId, prospectId])
  @@index([snapshotId])
  @@index([prospectId])
}

// Conteúdo versionado por canal/variante/toque. E-mail = documento de blocos
// (emailDoc → MJML); WhatsApp/LinkedIn = texto + metadados.
model StudioContent {
  id           String   @id @default(cuid())
  orgId        String
  campaignId   String
  campaign     StudioCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel      String   // email, whatsapp, linkedin_text
  variantLabel String   @default("A")   // variante de experimento/tonalidade
  kind         String   @default("base") // base | followup
  stepIndex    Int      @default(1)      // 1 = toque principal; 2..n = follow-ups
  title        String?
  emailDoc     Json?                     // documento de blocos do editor → MJML
  subject      String?
  preheader    String?
  whatsappText String?
  whatsappMeta Json?                     // botões/CTA, mídia, template Meta compatível
  linkedinText String?
  ctaUrl       String?
  tone         String?                   // formal, comercial, tecnico, urgente, custom
  origin       String   @default("manual") // ai, manual, template, ai_from_material
  editHistory  Json     @default("[]")   // [{by,at,summary}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  personalizations StudioPersonalization[]

  @@index([campaignId, channel, variantLabel, kind, stepIndex])
}

// ── Campaign Studio — modelos das ondas US4/US5/US7 ────────────────────────

// Material de origem da criação (FR-023/024 010): upload, URL, prompt ou
// company_data; extração apresentada para confirmação humana.
model StudioMaterial {
  id               String   @id @default(cuid())
  orgId            String
  kind             String   // pdf, docx, pptx, image, video, url, prompt, company_data
  sourceRef        String?  // URL ou arquivo relativo em STUDIO_STORAGE_DIR
  mimeType         String?
  sizeBytes        Int?
  extraction       Json?    // {product, offer, benefits, audience, cta, confidence, sourceText}
  extractionStatus String   @default("pending") // pending, extracted, failed, needs_manual
  extractionError  String?
  confirmedAt      DateTime?
  uploadedById     String
  // ── Onda "criação sem bloqueios" (D7) — material ganha campanha ─────────
  // Nullable: materiais da org (sem campanha) continuam existindo; quando o
  // upload/composição acontece no contexto de uma campanha, o vínculo nasce
  // preenchido (aba Materiais lista por campanha e rotula à parte os da org).
  campaignId       String?
  campaign         StudioCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([orgId])
  @@index([campaignId])
}

// Anexo que sai JUNTO na mensagem (FR6 da onda 2026-09-29): e-mail como
// anexo do provider, WhatsApp como mídia (1 por mensagem). Diferente de
// StudioMaterial (insumo de IA): o anexo vive no storage do Studio e é
// resolvido NA LIBERAÇÃO do lote (D6), por REFERÊNCIA (D8 — nada de base64
// em JSONB). Tamanho/whitelist validados no upload (NFR5).
model StudioAttachment {
  id           String   @id @default(cuid())
  orgId        String
  campaignId   String?
  campaign     StudioCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fileName     String   // arquivo em STUDIO_STORAGE_DIR (saveBuffer — SHA-256)
  originalName String
  mimeType     String?
  sizeBytes    Int
  channels     String   @default("both") // email | whatsapp | both (canal destino)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([orgId])
  @@index([campaignId])
}

// Personalização por lead (FR-047–051 010): variação sobre o conteúdo base.
model StudioPersonalization {
  id              String   @id @default(cuid())
  orgId           String
  contentId       String
  content         StudioContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  prospectId      String
  overrides       Json     @default("{}") // {intro?, valueProp?, cta?, full?}
  dataBasis       Json     @default("[]") // fatos usados (explicável)
  status          String   @default("pending") // pending, generated, edited, base_fallback
  editedById      String?
  propagatedRule  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([contentId, prospectId])
  @@index([contentId])
}

// Biblioteca de templates por objetivo/estágio (FR-038 010; US13).
model StudioTemplate {
  id           String   @id @default(cuid())
  orgId        String   @default("system") // "system" = semente da plataforma
  name         String
  channel      String   // email, whatsapp, linkedin_text
  objective    String   // prospection, launch, promotion, newsletter, event, reactivation, nurturing
  funnelStage  String   @default("middle")
  subject      String?
  content      Json     @default("{}")
  variables    Json     @default("[]")
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId, objective])
}

// Classificação de respostas por IA (specs/010 FR-045) — e-mail e WhatsApp.
model StudioReplyClassification {
  id               String   @id @default(cuid())
  orgId            String
  prospectId       String
  channel          String   // email | whatsapp
  sourceMessageId  String   // OutreachMessage/WhatsAppMessage de origem
  label            String   // interested, not_interested, doubt, meeting_request, opt_out, out_of_scope, unclassified
  confidence       Float    @default(0)
  needsHumanReview Boolean  @default(false)
  confirmedById    String?
  createdAt        DateTime @default(now())

  @@index([orgId, prospectId])
  @@index([label])
}

// Journey visual do Studio (specs/010 US8, FR-052–056).
model StudioJourney {
  id           String   @id @default(cuid())
  orgId        String
  campaignId   String
  definition   Json     @default("{}")  // {blocks:[{id,type,config}], edges:[{from,to,branch?}]}
  triggers     Json     @default("[]")  // segment_enter | behavior | score_threshold | webhook
  stopConditions Json   @default("[]")  // reply | converted | opt_out
  status       String   @default("draft") // draft | active | paused
  webhookToken String?  // SHA-256 do token opaco (research D15)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads StudioJourneyLead[]

  @@index([orgId])
  @@index([campaignId])
}

// Estado por lead no journey (idempotência: @@unique journey+prospect).
model StudioJourneyLead {
  id             String    @id @default(cuid())
  orgId          String
  journeyId      String
  journey        StudioJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  prospectId     String
  currentBlockId String?
  waitingUntil   DateTime?
  status         String    @default("active") // active | waiting | waiting_human | done | stopped
  stopReason     String?
  blockHistory   Json      @default("[]") // [{blockId, enteredAt}]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([journeyId, prospectId])
  @@index([journeyId])
}

// Plano do AI Campaign Agent (specs/010 US9, FR-057/058).
model StudioAgentProposal {
  id            String   @id @default(cuid())
  orgId         String
  campaignId    String?
  requestPrompt String
  plan          Json     @default("{}")  // {audience, strategy, contents, tracking}
  items         Json     @default("[]")  // [{key, decision, editedValue?}]
  status        String   @default("proposed") // proposed | decided | converted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId])
}

// Recomendações do agente/otimização, sempre explicáveis (FR-059/FR-075).
model StudioRecommendation {
  id                    String   @id @default(cuid())
  orgId                 String
  campaignId            String?
  targetProspectId      String?
  kind                  String   // pace_change, subject_swap, pause_segment, next_best_action, fatigue, handoff
  rationale             String
  evidence              Json     @default("[]")
  status                String   @default("proposed") // proposed | applied | rejected
  appliedAt             DateTime?
  requiresConfirmation  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([orgId, campaignId])
}

// Experimento A/B (specs/010 US10, FR-060–063).
model StudioExperiment {
  id                      String   @id @default(cuid())
  orgId                   String
  campaignId              String
  dimension               String   // subject, copy, cta, send_time, channel
  split                   Json     @default("{}") // {A: 20, B: 80}
  winnerCriterion         Json     @default("{}") // {metric, minPerVariant, confidence}
  status                  String   @default("running") // running | winner_declared | closed
  winnerVariant           String?
  declaredAt              DateTime?
  declaredBasis           Json?
  continuousOptimization  Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([campaignId])
}

// Rollup diário de métricas do Studio (US11, FR-064–069).
model StudioMetricDaily {
  id                 String   @id @default(cuid())
  orgId              String
  campaignId         String
  day                DateTime
  channel            String   @default("email")
  variantLabel       String   @default("A")
  stepIndex          Int      @default(1)
  sent               Int      @default(0)
  delivered          Int      @default(0)
  deliveredEstimated Int      @default(0)
  opens              Int      @default(0)
  opensEstimated     Int      @default(0)
  clicks             Int      @default(0)
  replies            Int      @default(0)
  conversions        Int      @default(0)
  bounces            Int      @default(0)
  unsubs             Int      @default(0)
  whatsappReads      Int      @default(0)

  @@unique([campaignId, day, channel, variantLabel, stepIndex])
  @@index([campaignId])
}

// Perfil de marca (specs/010 US12, FR-070/071) — Brand Voice + Brand Kit.
model StudioBrandProfile {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  voice              Json     @default("{}") // {toneNotes, doExamples[], dontExamples[], learnedFrom[]}
  kit                Json     @default("{}") // {logoUrl, colors, fonts, assets[]}
  consistencyChecks  Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Parecer de conformidade pré-aprovação (US12, FR-073).
model StudioComplianceReview {
  id         String   @id @default(cuid())
  orgId      String
  campaignId String
  level      String   // ok | attention | block
  items      Json     @default("[]") // [{check, level, detail, affectedLeads?}]
  checkedById String?
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

// Conversa de criação de campanha (chat-first, specs/010 — iteração UX).
model StudioChatMessage {
  id          String   @id @default(cuid())
  orgId       String
  campaignId  String
  role        String   // user | assistant
  text        String
  attachments Json     @default("[]") // [{materialId, kind, url?}]
  cards       Json     @default("[]") // [{type, label, detail}] — o que o bot aplicou
  createdAt   DateTime @default(now())

  @@index([campaignId, createdAt])
}


// Telemetria de um turno do chat: métricas operacionais e ações executadas,
// sem persistir prompts/respostas ou outros conteúdos sensíveis.
model StudioChatTrace {
  id                  String   @id @default(cuid())
  orgId               String
  campaignId          String
  turnIndex           Int      @default(0)
  durationMs          Int      @default(0)
  llmDurationMs       Int      @default(0)
  llmModel            String?
  llmPromptTokens     Int?
  llmCompletionTokens Int?
  llmTotalTokens      Int?
  llmFallbackUsed    Boolean  @default(false)
  llmTruncated       Boolean  @default(false)
  status              String   @default("succeeded") // succeeded | failed | degraded
  errorCode           String?
  // Epic 1 (FR3): stack do erro real (nenhum catch descarta a causa — NFR4).
  errorStack          String?
  actionTypes         Json     @default("[]")
  actionDurationsMs   Json     @default("{}")
  createdAt           DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([campaignId, createdAt])
}

// ============================================================================
// CAMPAIGN STUDIO COCKPIT (specs/011) — Orçamento de Reputação, actions
// idempotentes, consentimento WhatsApp. Ledger transacional com writer único
// (studio/reputation.js) e gate fail-closed (studio/reputation-gate.js) —
// AD-3/AD-4 da spine de arquitetura.
// ============================================================================

// Conta de saldo por Canal (orgId+channel unique). `balance` só muta na MESMA
// transação que insere o StudioReputationEvent correspondente (AD-3).
model StudioReputationAccount {
  id                String    @id @default(cuid())
  orgId             String
  channel           String    // email | whatsapp
  balance           Int       @default(0)   // unidades disponíveis (1 unidade = 1 envio)
  floor             Int       @default(0)   // reserva mínima; efetivo só com domínio verificado (FR-16)
  ceiling           Int       @default(0)   // teto da rampa atual (warm-up contínuo — FR-17/FR-18)
  rampStage         Int       @default(0)   // estágio da rampa de warm-up
  // unverified | verified | failed — verificado por DNS (AD-8), nunca declarado
  domainAuthStatus  String    @default("unverified")
  domainAuthCheckedAt DateTime?
  domainAuthDetail  Json      @default("{}") // {spf, dkim, dmarc} + detalhes da última checagem
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([orgId, channel])
  @@index([orgId])
}

// Ledger append-only (AD-3/AD-13). Estorno idempotente: unique (type, refId)
// impede duplo crédito sob qualquer retry/requeue do worker.
model StudioReputationEvent {
  id           String   @id @default(cuid())
  orgId        String
  channel      String   // email | whatsapp
  type         String   // debit | credit | block
  amount       Int      // unidades movidas (sempre > 0; a direção está no type)
  balanceAfter Int      // saldo resultante (auditoria FR-20)
  reason       String?  // explicação legível (bloqueio, reposição, estorno)
  refType      String?  // batch | send | ramp | grant | complaint | pause
  refId        String?  // batchId | messageId | dia | ...
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@unique([type, refId])
  @@index([orgId, channel, createdAt])
}

// Execução idempotente de actions semânticas v1 (AD-6, FR-9): chave estável
// (campaignId+action+hash(params) ou actionId do cliente) — duplo toque não
// duplica segmento/conteúdo; a 2ª chamada devolve o resultado da 1ª.
model StudioActionRun {
  id         String   @id @default(cuid())
  orgId      String
  campaignId String
  action     String   // set_objective | set_audience | attach_url | confirm_material | generate_content | set_schedule | …
  actionKey  String   // chave de idempotência (unique)
  status     String   @default("succeeded") // succeeded | failed
  result     Json     @default("{}")  // card devolvido na 1ª execução (replay idempotente)
  createdAt  DateTime @default(now())

  @@unique([actionKey])
  @@index([orgId, campaignId])
}

// Consentimento WhatsApp persistido e auditável por lead (AD-11, FR-35) —
// nunca inferido em memória; consultado pelo Certificado (FR-27/FR-36).
model StudioLeadConsent {
  id          String   @id @default(cuid())
  orgId       String
  prospectId  String
  channel     String   @default("whatsapp")
  source      String   // email_reply | opt_in | manual
  grantedById String?  // user.id quando manual
  evidence    Json     @default("{}") // {classificationId?, messageId?, note?}
  createdAt   DateTime @default(now())

  @@unique([orgId, prospectId, channel])
  @@index([orgId])
}
